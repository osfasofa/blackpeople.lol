---
import { overlay } from '../config';

interface Props {
	slug: string;
	youtube: string;
	title?: string;
	blurb?: string;
}

const { slug, youtube, title, blurb } = Astro.props;

const showTitle = overlay.show && Boolean(title);
const showBlurb = overlay.show && overlay.showBlurb && Boolean(blurb);
/* Without this the gradient would still paint over a post that has neither. */
const showOverlay = showTitle || showBlurb;

/*
 * Shown over the iframe until the first frame is actually rolling, so
 * YouTube's poster-with-play-button never gets a chance to appear.
 *
 * maxresdefault is missing for older uploads, and YouTube answers with a
 * 120px "not found" picture instead of an error, so the swap to hqdefault is
 * done by checking the decoded width rather than relying on onerror.
 */
const poster = `https://i.ytimg.com/vi/${youtube}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg`;
const posterSwap =
	'if(this.src!==this.dataset.fallback&&this.naturalWidth<=120)this.src=this.dataset.fallback';

/* Titles are optional, so anything user-facing needs a fallback. */
const sectionLabel = title ?? 'Video';
const tapLabel = title ? `Play or pause ${title}` : 'Play or pause';
const commentLabel = title ? `Comments on ${title}` : 'Comments';
---

<section
	class="video"
	data-video-section
	data-video-id={youtube}
	data-slug={slug}
	aria-label={sectionLabel}
>
	<div class="video__crop">
		{/* The IFrame API swaps this div out for the iframe it creates. */}
		<div id={`yt-${slug}`} data-video-mount></div>
	</div>

	<img
		class="video__poster"
		src={poster}
		data-fallback={posterFallback}
		alt=""
		aria-hidden="true"
		decoding="async"
		onload={posterSwap}
		onerror="if(this.src!==this.dataset.fallback)this.src=this.dataset.fallback"
	/>

	<button class="video__tap" data-video-tap type="button" aria-label={tapLabel}></button>

	{
		showOverlay && (
			<div class="overlay">
				{showTitle && <h2 class="overlay__title">{title}</h2>}
				{showBlurb && <p class="overlay__blurb">{blurb}</p>}
			</div>
		)
	}

	<button
		class="comment-button"
		type="button"
		data-comment-open={slug}
		data-comment-label={title ?? 'Comments'}
		aria-label={commentLabel}
	>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
			<path
				d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
			></path>
		</svg>
	</button>
</section>
